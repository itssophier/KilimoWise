# KiliMoWise local environment
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# JWT (must be >= 32 bytes / 256 bits for HS256)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Local PostgreSQL (override what render.yaml provides)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=postgres
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
