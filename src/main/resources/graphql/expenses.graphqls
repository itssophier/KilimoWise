enum ExpensesCategory {
    SEEDS
    FERTILIZER
    PESTICIDES
    VETERINARY
    LABOR
    TRANSPORT
    OTHER
}

type Expenses {
    id: ID!
    category: ExpensesCategory!
    amount: Float!
    description: String
    expenseDate: String
}

input ExpensesInput {
    farmerId: ID!
    category: ExpensesCategory!
    amount: Float!
    description: String!
    expenseDate: String
}

type MonthlyTotal {
    month: String
    total: Float
}

type ExpenseStats {
    totalAllTime: Float
    totalThisMonth: Float
    totalLastMonth: Float
    monthChangePercent: Float
    topCategory: String
    topCategoryAmount: Float
    byCategory: JSON
    monthlyTrend: [MonthlyTotal]
}

scalar JSON

extend type Query {
    getExpense(farmerId: ID!): [Expenses]
    getExpenseStats(farmerId: ID!): ExpenseStats
}

extend type Mutation {
    addExpense(input: ExpensesInput!): Expenses
}